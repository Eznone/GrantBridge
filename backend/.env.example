# GrantBridge Backend Environment Variables
# Copy this file to .env and fill in your values

# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# For development (SQLite - default)
# DATABASE_URL=sqlite:///db.sqlite3

# For production (Supabase PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# CORS Configuration
# Development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production (add your Vercel domains)
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=10080

# IBM watsonx.ai Configuration
WATSONX_API_KEY=your-watsonx-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Vector Store Configuration
VECTOR_STORE_PATH=./vector_store
FAISS_INDEX_PATH=./faiss_index

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@grantbridge.org

# Sentry Error Tracking (Optional - Production only)
# SENTRY_DSN=your-sentry-dsn-here

# File Upload Settings
MAX_UPLOAD_SIZE=10485760

# Rate Limiting (requests per minute)
RATE_LIMIT_AUTH=10
RATE_LIMIT_API=100