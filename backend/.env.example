# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Supabase PostgreSQL)
# For local development, use local PostgreSQL or SQLite
# For production, use Supabase connection string
DATABASE_URL=postgresql://user:password@localhost:5432/grantbridge

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=10080

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Services - IBM watsonx.ai
WATSONX_API_KEY=your-watsonx-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Vector Store Configuration
VECTOR_STORE_PATH=./vector_store
FAISS_INDEX_PATH=./faiss_index

# Optional: Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@grantbridge.org

# Optional: Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn-url

# Optional: Redis (for Celery - Phase 3)
REDIS_URL=redis://localhost:6379/0